#!/usr/bin/env bash
# dinnno — harness helper CLI. Runs the deterministic parts of the workflow so the
# model does not have to: project state check, plan gates, artifact tidy, cross-model review.
#
#   dinnno check  [--hook]                 project state summary (sizes, placeholders, sync, open decisions)
#   dinnno gates  <plan.md> [--record] [--timeout SEC]
#   dinnno tidy   [--apply FILE...]        list loose artifacts; --apply moves given files to docs/archive/
#   dinnno review --with codex|claude PROMPT.md [-o OUT.md] [--unsafe]
#
# Works from anywhere inside a dinnno project (a repo that has docs/RESEARCH_SPEC.md).
set -uo pipefail

HARNESS_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
export DINNNO_SIZE_LIMIT="${DINNNO_SIZE_LIMIT:-51200}"

find_root() {
  local d="${1:-$PWD}"
  while [[ "$d" != "/" ]]; do
    [[ -f "$d/docs/RESEARCH_SPEC.md" ]] && { echo "$d"; return 0; }
    d="$(dirname "$d")"
  done
  return 1
}

kb() { printf "%dK" $(( ( $(wc -c < "$1") + 512 ) / 1024 )); }
trunc() { python3 -c 'import sys;n=int(sys.argv[1]);[print(l.rstrip("\n")[:n]) for l in sys.stdin]' "$1"; }

# ---------------------------------------------------------------- check
cmd_check() {
  local hook=0; [[ "${1:-}" == "--hook" ]] && hook=1
  local root; root="$(find_root)" || { (( hook )) && exit 0; echo "not a dinnno project (docs/RESEARCH_SPEC.md not found)"; exit 1; }
  command -v python3 >/dev/null || { echo "[dinnno] python3 없음 — check 건너뜀"; exit 0; }
  python3 - "$root" "$HARNESS_DIR" "$hook" <<'PY'
import os, re, sys, glob
root, hd, hook = sys.argv[1], sys.argv[2], sys.argv[3] == "1"
os.chdir(root)
LIMIT = int(os.environ.get("DINNNO_SIZE_LIMIT", "51200"))
out = []
def size(p): return os.path.getsize(p)
def kb(p): return f"{(size(p)+512)//1024}K"
def read(p):
    try: return open(p, encoding="utf-8", errors="replace").read()
    except FileNotFoundError: return ""
def latest(d, prefix):
    fs = [f for f in os.listdir(d) if re.match(rf"{prefix}_v\d+", f) and "_codex" not in f and "_template" not in f] if os.path.isdir(d) else []
    return max(fs, key=lambda f: int(re.search(r"_v(\d+)", f).group(1)), default=None)
def vnum(f): return int(re.search(r"_v(\d+)", f).group(1)) if f else 0

# instruction files
has_a, has_c = os.path.exists("AGENTS.md"), os.path.exists("CLAUDE.md")
if has_a and has_c:
    c = read("CLAUDE.md").strip()
    if c != "@AGENTS.md" and c != read("AGENTS.md").strip():
        out.append("⚠ AGENTS.md와 CLAUDE.md 내용이 다르다 — 한쪽을 정본으로 두고 CLAUDE.md는 '@AGENTS.md' 한 줄로")
inst = "AGENTS.md" if has_a else "CLAUDE.md"

# sizes
plan, done = latest("docs/plans", "plan"), latest("docs/done", "done")
files = [inst, "docs/RESEARCH_SPEC.md", "docs/ARCHITECTURE.md", "docs/progress.md", "docs/LEARNINGS.md"] + ([f"docs/plans/{plan}"] if plan else [])
sizes, big = [], []
for f in files:
    if not os.path.exists(f): out.append(f"없음: {f}"); continue
    sizes.append(f"{os.path.basename(f)} {kb(f)}")
    if size(f) > LIMIT: big.append(f)
out.append("크기: " + " · ".join(sizes))
if big: out.append(f"⚠ {LIMIT}B 초과 — 통째로 읽지 말고 필요한 절만 grep: " + " ".join(big))

# placeholders
ph = 0
for f in (inst, "docs/RESEARCH_SPEC.md"):
    for line in read(f).splitlines():
        if re.match(r"\s*(#|>|\||```)", line): continue
        line = re.sub(r"`[^`]*`", "", line)  # ignore code spans
        if any(not re.fullmatch(r"N([+-]\d+)?|[\d\s,.\-]+", m) for m in re.findall(r"\{([^{}]{1,40})\}", line)): ph += 1
if ph: out.append(f"placeholder {{…}} {ph}줄 남음 ({inst} / RESEARCH_SPEC) — init 또는 spec 단위 후보")

# plan/done pairing
pn, dn = vnum(plan), vnum(done)
if pn > dn: out.append(f"진행 중 단위: docs/plans/{plan} (done_v{pn} 없음)")
elif pn: out.append(f"마지막 단위 닫힘: plan_v{pn} / {done} — 다음 단위는 사용자 선택")

# gates of the in-progress plan: definition drift vs last record, pending manual gates
if pn > dn and plan:
    import hashlib
    pt = read(f"docs/plans/{plan}")
    sec = re.search(r"^#+ [^\n]*게이트[^\n]*\n(.*?)(?=^#+ |\Z)", pt, re.S | re.M)
    def cell(row, i):
        parts = re.split(r"(?<!\\)\|", row)
        if len(parts) <= i: return ""
        c = parts[i].replace("\\|", "|").strip(" ")
        if c.startswith("`"): c = c[1:]
        if c.endswith("`"): c = c[:-1]
        return c
    gates = []
    if sec:
        lines = [l for l in sec.group(1).splitlines() if l.startswith("|")]
        hi = next((i for i, l in enumerate(lines) if re.match(r"\|\s*gate\s*\|", l)), None)
        for row in (lines[hi + 2:] if hi is not None else []):
            name = re.split(r"(?<!\\)\|", row)[1].strip(" ") if row.count("|") >= 2 else ""
            if not name or name.startswith("{"): continue
            cmd, exp = cell(row, 2), cell(row, 3)
            gates.append((name, cmd, hashlib.sha256(f"{name}|{cmd}|{exp}".encode()).hexdigest()[:8]))
    recs = re.findall(r"^- \d{4}-\d{2}-\d{2} gates: .*$", pt, re.M)
    prev = dict(re.findall(r"(\S+?)#([0-9a-f]{8})=", recs[-1])) if recs else {}
    stale = [n for n, _, h in gates if n in prev and prev[n] != h]
    if stale: out.append("⚠ plan §3 게이트 정의가 마지막 gates 기록과 다름 (이전 PASS 무효, 재실행 필요): " + ", ".join(stale))
    pend = [n for n, c, h in gates if c.upper().startswith("MANUAL:") and not re.search(rf"^- \d{{4}}-\d{{2}}-\d{{2}} 확인 {re.escape(n)}#{h}:", pt, re.M)]
    if pend: out.append(f"수동 게이트 확인 대기 {len(pend)}건: " + ", ".join(pend))

# session-close contract: open TODOs of the in-progress plan, latest done indexed in progress
if pn > dn and plan:
    todo = re.search(r"^#+ [^\n]*TODO[^\n]*\n(.*?)(?=^#+ |\Z)", read(f"docs/plans/{plan}"), re.S | re.M)
    if todo:
        n_open = sum(1 for l in todo.group(1).splitlines() if l.startswith("- [ ]") and not l[6:].lstrip().startswith("{"))
        if n_open: out.append(f"plan TODO 미체크 {n_open}건 ({plan})")
if dn and done and f"done_v{dn}" not in read("docs/progress.md"):
    out.append(f"progress.md에 {done} 언급 없음 — 타임라인 행·Matrix 셀·헤더 갱신(종료 계약)")

# v4 migration status
mig = []
if not has_a: mig.append("AGENTS.md 없음 (git mv CLAUDE.md AGENTS.md && echo '@AGENTS.md' > CLAUDE.md)")
if os.path.exists("docs/LEARNINGS.md") and "현재 유효" not in read("docs/LEARNINGS.md"): mig.append("LEARNINGS '현재 유효' 절 없음")
if "현재 방향" not in read("docs/RESEARCH_SPEC.md"): mig.append("SPEC '현재 방향' 블록 없음")
if mig: out.append("v4 이관 필요: " + " · ".join(mig))
if len(read(inst)) > 10000: out.append(f"⚠ {inst} {len(read(inst))}자 — Grok은 규칙 파일을 10,000자에서 잘라 읽는다")
cur = re.search(r"^## [^\n]*현재 유효[^\n]*\n(.*?)(?=^## |\Z)", read("docs/LEARNINGS.md"), re.S | re.M)
if cur:
    n_cur = sum(1 for l in cur.group(1).splitlines() if l.startswith("- "))
    if n_cur > 20: out.append(f"LEARNINGS '현재 유효' {n_cur}줄 — 20줄 안으로 통폐합하거나 이력으로 내린다")

# unchecked decisions
prog = read("docs/progress.md")
m = re.search(r"^## [^\n]*결정 큐[^\n]*\n(.*?)(?=^## |\Z)", prog, re.S | re.M)
if m:
    items = [l for l in m.group(1).splitlines() if l.startswith("- [ ]") and not l[6:].lstrip().startswith("{")]
    if items: out.append(f"미결 결정 {len(items)}건: " + " | ".join(l[6:86] for l in items[:3]))

# harness sync
norm = lambda s: re.sub(r"[^0-9A-Za-z가-힣]", "", s)
mk = re.search(r"last-sync:\s*(.+)", read(inst))
mk = mk.group(1).strip() if mk else ""
if not mk or "{" in mk:
    out.append(f"last-sync 마커 없음/placeholder — {inst}의 'last-sync:'를 본체 CHANGELOG 마지막 항목으로")
else:
    entries = [l[2:] for l in read(os.path.join(hd, "CHANGELOG.md")).splitlines() if re.match(r"- \d{4}-\d{2}-\d{2} — ", l)]
    key = norm(mk)[:12]
    idx = next((i for i, e in enumerate(entries) if norm(e).startswith(key)), None)
    if idx is None:
        d = mk[:10]; unsynced = [e for e in entries if e[:10] >= d]
    else:
        unsynced = entries[idx + 1:]
    if unsynced:
        out.append(f"하네스 미동기 {len(unsynced)}건 (last-sync: {mk[:40]}): " + " | ".join(e[:70] for e in unsynced))

pre = "[dinnno] " if hook else ""
print("\n".join(pre + l for l in out))
PY
}

# ---------------------------------------------------------------- gates
# Gate table (plan section whose heading contains '게이트'): | gate | command | expect |
#  - hash  = sha256(name|command|expect)[:8]; printed as #hash and stored in the §5 record line,
#            so a gate edited after a PASS shows up as STALE instead of borrowing the old evidence.
#  - MANUAL: <what a human checks>  → not executed. PASS only when the plan has a confirmation line
#            "- YYYY-MM-DD 확인 <gate>#<hash>: <사용자 발화>" whose hash matches the current definition.
gate_hash() { printf '%s|%s|%s' "$1" "$2" "$3" | sha256sum | cut -c1-8; }
cell() { # cell <row> <n>  (unescapes \| inside the cell, strips spaces and one backtick each side)
  sed 's/\\|/\x01/g' <<< "$1" | cut -d'|' -f"$2" | tr '\001' '|' | sed 's/^ *`\{0,1\}//;s/`\{0,1\} *$//'
}
cmd_gates() {
  local plan="" record=0 timeout=600
  while (( $# )); do case "$1" in
    --record) record=1;; --timeout) timeout="$2"; shift;;
    *) [[ -n "$plan" ]] && { echo "plan 파일은 하나만 지정한다 (받은 것: $plan, $1) — glob이 리뷰 파일까지 펼친 것일 수 있다"; exit 2; }; plan="$1";; esac; shift; done
  [[ -f "$plan" ]] || { echo "usage: dinnno gates <plan.md> [--record] [--timeout SEC]"; exit 2; }
  case "$(basename "$plan")" in *_codex*|*_template*) echo "리뷰·템플릿 파일이 아니라 plan 본문을 지정한다: $plan"; exit 2;; esac
  plan="$(readlink -f "$plan")"
  local root; root="$(find_root "$(dirname "$plan")")" || root="$PWD"
  cd "$root"
  local rows; rows=$(awk 'f && /^#+ /{exit} /^#+ .*게이트/{f=1;next} f && !t && /^\| *gate *\|/{t=1;getline;next} f && t && /^\|/' "$plan")
  [[ -z "$rows" ]] && { echo "게이트 표 없음: $plan (heading에 '게이트'가 있는 절 안의 | gate | command | expect | 표)"; exit 2; }
  # previous record: "- DATE gates: n/m PASS (dinnno gates) name#hash=RESULT ..."
  declare -A prev
  local last; last=$(grep -E '^- [0-9]{4}-[0-9]{2}-[0-9]{2} gates: ' "$plan" | tail -1)
  local tok; for tok in $(grep -oE '[^ ]+#[0-9a-f]{8}=[A-Z]+' <<< "$last"); do prev["${tok%%#*}"]="${tok#*#}"; done
  local pass=0 total=0 pending=0 rec="" notes="" hints=""
  local report="| gate | #hash | result | evidence |"$'\n'"|---|---|---|---|"
  while IFS= read -r row; do
    [[ -z "$row" ]] && continue
    local name cmd expect h
    name=$(cut -d'|' -f2 <<< "$row" | sed 's/^ *//;s/ *$//')
    cmd=$(cell "$row" 3); expect=$(cell "$row" 4)
    [[ -z "$name" || "$name" == "{"* ]] && continue
    total=$((total+1)); h=$(gate_hash "$name" "$cmd" "$expect")
    if [[ -n "${prev[$name]:-}" && "${prev[$name]%%=*}" != "$h" ]]; then
      notes+="정의 변경: $name #${prev[$name]%%=*} → #$h — 이전 기록의 결과는 무효, 이번 결과만 유효"$'\n'
    fi
    local result evidence
    if [[ "${cmd^^}" == MANUAL:* ]]; then
      local conf; conf=$(grep -F -- " 확인 ${name}#" "$plan" | grep -E '^- [0-9]{4}-[0-9]{2}-[0-9]{2} 확인 ' | tail -1)
      local ch; ch=$(grep -oE "#[0-9a-f]{8}" <<< "$conf" | head -1 | tr -d '#')
      local said; said=$(sed 's/^[^:]*: *//' <<< "$conf" | sed 's/^"//;s/"$//')
      if [[ -n "$conf" && "$ch" == "$h" && -n "$said" && "$said" != *"<사용자 발화>"* ]]; then
        pass=$((pass+1)); result="PASS (manual)"; evidence=$(trunc 100 <<< "\"$said\"")
      elif [[ -n "$conf" && "$ch" == "$h" ]]; then
        result="PENDING"; evidence="확인 줄에 사용자 발화가 비어 있다 — 실제 발화를 적는다"; pending=$((pending+1))
      elif [[ -n "$conf" ]]; then
        result="STALE"; evidence="확인 당시 #$ch ≠ 현재 #$h — 다시 확인 필요"; pending=$((pending+1))
      else
        result="PENDING"; evidence="사용자 확인 필요: $(sed "s/^ *//" <<< "${cmd#*:}")"; pending=$((pending+1))
        hints+="확인되면 plan 파일에 이 줄을 추가(§5 권장): - $(date +%F) 확인 ${name}#${h}: \"<사용자 발화>\""$'\n'
      fi
    else
      local outp rc; outp=$(timeout "$timeout" bash -o pipefail -c "$cmd" 2>&1); rc=$?
      evidence=$(tail -1 <<< "$outp" | trunc 100)
      if (( rc == 0 )) && { [[ -z "$expect" ]] || grep -qE -- "$expect" <<< "$outp"; }; then
        pass=$((pass+1)); result="PASS"
      else result="FAIL (rc=$rc)"; fi
    fi
    report+=$'\n'"| $name | #$h | $result | $evidence |"
    rec+=" ${name}#${h}=${result%% *}"
  done <<< "$rows"
  (( total == 0 )) && { echo "실행 가능한 게이트 없음: 표에 placeholder 행뿐 — plan §3을 먼저 채운다 ($plan)"; exit 2; }
  echo "$report"; echo
  [[ -n "$notes" ]] && printf "%s" "$notes"
  [[ -n "$hints" ]] && printf "%s" "$hints"
  echo "gates: $pass/$total PASS$( (( pending )) && echo ", $pending 대기(수동)")  ($(date +%F) $(git rev-parse --short HEAD 2>/dev/null))"
  if (( record )); then
    printf -- "- %s gates: %d/%d PASS (dinnno gates)%s\n" "$(date +%F)" "$pass" "$total" "$rec" >> "$plan"
    echo "recorded → $plan"
  fi
  (( pass == total ))
}

# ---------------------------------------------------------------- tidy
cmd_tidy() {
  local root; root="$(find_root)" || { echo "not a dinnno project"; exit 1; }
  cd "$root"
  if [[ "${1:-}" == "--apply" ]]; then
    shift; (( $# )) || { echo "usage: dinnno tidy --apply FILE..."; exit 2; }
    local failed=0
    for f in "$@"; do
      [[ -f "$f" ]] || { echo "skip (없음): $f"; continue; }
      local m; m=$(date -r "$f" +%Y-%m); mkdir -p "docs/archive/$m"
      local base="docs/archive/$m/$(basename "$f")" dest k=1
      dest="$base"; while [[ -e "$dest" ]]; do dest="${base%.md}_$(date -r "$f" +%d)_$k.md"; k=$((k+1)); done
      if git ls-files --error-unmatch "$f" >/dev/null 2>&1; then git mv "$f" "$dest"; else mv -n "$f" "$dest"; fi
      [[ -e "$dest" && ! -e "$f" ]] || { echo "이동 실패: $f (인덱스에 기록하지 않음)"; failed=1; continue; }
      [[ -f docs/archive/_INDEX.md ]] || echo "# archive index" > docs/archive/_INDEX.md
      printf -- "- \`%s\` → \`%s\` — %s\n" "$f" "$dest" "$(date +%F) tidy" >> docs/archive/_INDEX.md
      echo "moved: $f → $dest"
    done
    return $failed
  fi
  echo "정규 집합 밖 md (후보 — 내용을 열어 소비 여부를 판단한 뒤 --apply):"
  { ls *.md 2>/dev/null | grep -vE '^(README|AGENTS|CLAUDE)\.md$' | sed 's|^|./|'
    ls docs/*.md 2>/dev/null | grep -vE 'docs/(RESEARCH_SPEC|ARCHITECTURE|progress|LEARNINGS|LOOP|_GUIDE)\.md$'
    ls docs/notes/*.md 2>/dev/null
  } | while read -r f; do printf "  %-60s %s %5s\n" "$f" "$(date -r "$f" +%F)" "$(kb "$f")"; done
  for d in docs/*/; do case "$(basename "$d")" in plans|done|references|notes|archive|experiments) ;; *) echo "  비정규 폴더: $d";; esac; done
}

# ---------------------------------------------------------------- review
cmd_review() {
  local with="" prompt="" out="" unsafe=0
  while (( $# )); do case "$1" in
    --with) with="$2"; shift;; -o) out="$2"; shift;; --unsafe) unsafe=1;; *) prompt="$1";; esac; shift; done
  [[ -f "$prompt" && -n "$with" ]] || { echo "usage: dinnno review --with codex|claude PROMPT.md [-o OUT.md] [--unsafe]"; exit 2; }
  local root; root="$(find_root)" || root="$PWD"
  prompt="$(readlink -f "$prompt")"
  [[ -z "$out" ]] && out="${prompt%.md}_out.md"
  local log="${out%.md}_log.txt"
  rm -f "$out"   # only output produced by this run counts as evidence
  local before; before=$(git -C "$root" status --porcelain 2>/dev/null)
  local start; start=$(date +%s)
  local rc
  case "$with" in
    codex)
      local sb="read-only"; (( unsafe )) && sb="danger-full-access"
      codex exec -s "$sb" -C "$root" -m "${DINNNO_CODEX_MODEL:-gpt-5.6-sol}" -c model_reasoning_effort="${DINNNO_CODEX_EFFORT:-xhigh}" \
        --skip-git-repo-check -o "$out" \
        "다음 파일을 읽고 그 안의 지시를 그대로 수행하라: $prompt — read-only 검토다. 어떤 파일도 수정하지 마라." > "$log" 2>&1
      rc=$?
      ;;
    claude)
      ( cd "$root" && claude -p "$(cat "$prompt")

이 검토는 read-only다. 파일을 수정하지 말고 결과만 출력하라." \
          --model "${DINNNO_CLAUDE_MODEL:-opus}" --allowedTools Read Grep Glob > "$out" 2> "$log" )
      rc=$?
      ;;
    *) echo "unknown --with $with"; exit 2;;
  esac
  local after; after=$(git -C "$root" status --porcelain 2>/dev/null)
  local fail=""
  (( rc != 0 )) && fail+="exit=$rc "
  [[ -s "$out" ]] || fail+="empty-output "
  [[ "$before" == "$after" ]] || fail+="worktree-changed "
  if (( unsafe )); then
    local touched; touched=$(find "$root" -newermt "@$start" -type f -not -path '*/.git/*' -not -path "$out" -not -path "$log" | head -5)
    [[ -n "$touched" ]] && fail+="files-touched($touched) "
  fi
  if [[ -n "$fail" ]]; then
    echo "REVIEW FAILED: $fail — log: $log"
    grep -qiE 'bwrap|Operation not permitted' "$log" 2>/dev/null && (( ! unsafe )) && echo "sandbox 실패가 재현됨 → 이번 한 번만 --unsafe 로 재시도 (danger-full-access, 종료 후 무수정 검증 포함)"
    exit 1
  fi
  echo "REVIEW OK: $out ($(kb "$out"), ${with})"
}

case "${1:-}" in
  check)  shift; cmd_check "$@";;
  gates)  shift; cmd_gates "$@";;
  tidy)   shift; cmd_tidy "$@";;
  review) shift; cmd_review "$@";;
  *) sed -n '2,10p' "$0"; exit 2;;
esac
